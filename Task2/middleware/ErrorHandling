const errorHandler = (err, req, res, next) => {
    // 1. Check for MongoDB's Duplicate Key Error (Code 11000)
    if (err.code === 11000) {
        const field = Object.keys(err.keyValue)[0];
        return res.status(400).json({ 
            message: `An account with that ${field} already exists.` 
        });
    }

    // 2. Catch invalid or tampered JWTs
    if (err.name === 'JsonWebTokenError') {
        return res.status(401).json({ 
            message: "Invalid token. Authorization denied." 
        });
    }

    // 3. Catch expired JWTs
    if (err.name === 'TokenExpiredError') {
        return res.status(401).json({ 
            message: "Token has expired. Please use your refresh token or log in again." 
        });
    }

    // 4. Default fallback for any other errors
    const statusCode = res.statusCode === 200 ? 500 : res.statusCode;
    
    res.status(statusCode).json({
        message: err.message || "Internal Server Error",
        stack: process.env.NODE_ENV === 'production' ? null : err.stack
    });
};

module.exports = errorHandler;